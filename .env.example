# Connection string de Postgres (ej: Neon — https://neon.tech).
# DATABASE_URL: la variante *pooled* (host con "-pooler"), usada por la app en runtime.
# DIRECT_URL: la variante directa (host sin "-pooler"), usada solo por Prisma Migrate.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secreto de Auth.js. Generar uno propio con: npx auth secret
AUTH_SECRET=""

# Token del Blob Store de Vercel (Storage → Create Database → Blob).
# Sin esto, las subidas de imágenes en el panel admin fallan con un error claro.
BLOB_READ_WRITE_TOKEN=""
